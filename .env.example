# ==============================================================================
# CargoPredict — Environment Configuration Template
# Copy this file to backend/.env and provide real credentials
# ==============================================================================

# Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Example: postgresql://postgres.xxxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Application Security Secret Key for JWT Token Generation
CARGOPREDICT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
TOKEN_EXPIRY_HOURS=24

# Server Host and Port
APP_HOST=127.0.0.1
APP_PORT=8000
